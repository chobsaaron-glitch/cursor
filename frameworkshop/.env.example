# PostgreSQL connection string
DATABASE_URL="postgresql://fw:fw@127.0.0.1:5432/frameworkshop_dev?schema=public"

# Secret used to sign session cookies (min 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-min-32-characters-long"

# Session lifetime in seconds (default 12 hours)
AUTH_SESSION_TTL=43200

# File storage driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_PREFIX=/api/files

# S3 / MinIO (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notification providers (console driver keeps everything in the internal inbox)
NOTIFY_EMAIL_DRIVER=console
NOTIFY_SMS_DRIVER=console
NOTIFY_TELEGRAM_DRIVER=console
TELEGRAM_BOT_TOKEN=
TEST_DATABASE_URL="postgresql://fw:fw@127.0.0.1:5432/frameworkshop_test?schema=public"
